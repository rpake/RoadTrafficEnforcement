generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model Officer { id String @id @default(uuid()) badgeNumber String @unique name String role String @default("officer") createdAt DateTime @default(now()) violations Violation[] }
model Violation { id String @id @default(uuid()) plate String driverName String? licenceNumber String? offenceCodes Json totalPGK Decimal @db.Decimal(12,2) location String notes String? officerId String officer Officer @relation(fields:[officerId],references:[id]) createdAt DateTime @default(now()) status String @default("draft") }
model FineSchedule { id String @id @default(uuid()) code String @unique description String amountPGK Decimal @db.Decimal(12,2) effectiveFrom DateTime effectiveTo DateTime? active Boolean @default(false) }
